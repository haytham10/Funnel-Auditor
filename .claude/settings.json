{
  "permissions": {
    "allow": [
      "mcp__Airtable__list_bases",
      "mcp__Airtable__list_tables_for_base",
      "mcp__Airtable__get_table_schema",
      "mcp__Airtable__list_records_for_table",
      "mcp__Airtable__search_records",
      "mcp__Airtable__create_records_for_table",
      "mcp__Airtable__update_records_for_table",
      "WebSearch",
      "WebFetch",
      "Bash(python main.py *)",
      "Bash(python3 main.py *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/schema_drift.py\"",
            "statusMessage": "Checking the CRM schema",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/skills_authoritative.py\""
          }
        ]
      }
    ]
  }
}
